# Each invocation checks status, exact stdout, and stderr independently.
function(cli_case name tool status output error)
  add_test(NAME cli_${name} COMMAND "${CMAKE_COMMAND}"
    "-DTOOL=$<TARGET_FILE:${tool}>" "-DARGS=${ARGN}"
    "-DEXPECT_STATUS=${status}" "-DEXPECT_FILE=${output}" "-DEXPECT_ERROR=${error}"
    -P "${CMAKE_CURRENT_SOURCE_DIR}/tests/assert_cli.cmake")
endfunction()
set(examples "${CMAKE_CURRENT_SOURCE_DIR}/examples")
foreach(example arithmetic factorial shadowing if_else nested_loops zero_iteration loop_local negative unreachable_error initializer operators demo)
  foreach(level 0 1)
    cli_case(${example}_O${level} minic 0 "${examples}/${example}.out" "" --run "${examples}/${example}.mc" -O${level})
  endforeach()
  cli_case(check_${example} minic 0 "" "" --check "${examples}/${example}.mc")
  cli_case(emit_${example} minic 0 "" "" --emit-bytecode "${examples}/${example}.mc" -o "${CMAKE_CURRENT_BINARY_DIR}/${example}.mbc")
  set_tests_properties(cli_emit_${example} PROPERTIES FIXTURES_SETUP bytecode_${example})
  cli_case(vm_${example} minic-vm 0 "${examples}/${example}.out" "" "${CMAKE_CURRENT_BINARY_DIR}/${example}.mbc")
  set_tests_properties(cli_vm_${example} PROPERTIES FIXTURES_REQUIRED bytecode_${example})
endforeach()
cli_case(version minic 0 "${CMAKE_CURRENT_SOURCE_DIR}/tests/expected/version.out" "" --version)
cli_case(vm_version minic-vm 0 "${CMAKE_CURRENT_SOURCE_DIR}/tests/expected/vm_version.out" "" --version)
cli_case(missing_mode minic 2 "" "explicit action" "${examples}/factorial.mc")
cli_case(no_args minic 2 "" "explicit action")
cli_case(conflict minic 2 "" "conflicting action" --run --ir "${examples}/factorial.mc")
cli_case(unknown minic 2 "" "unknown option" --wat)
cli_case(missing_input minic 2 "" "input file" --run)
cli_case(extra_input minic 2 "" "exactly one input" --run a.mc b.mc)
cli_case(missing_output minic 2 "" "requires -o" --emit-bytecode "${examples}/factorial.mc")
cli_case(empty_output minic 2 "" "-o requires" --emit-bytecode "${examples}/factorial.mc" -o)
cli_case(wrong_output_mode minic 2 "" "only valid" --run "${examples}/factorial.mc" -o out.mbc)
cli_case(duplicate_optimization minic 2 "" "only once" --run "${examples}/factorial.mc" -O0 -O1)
cli_case(missing_file minic 2 "" "cannot open" --run "${CMAKE_CURRENT_BINARY_DIR}/missing.mc")
cli_case(input_directory minic 2 "" "cannot read" --check "${examples}")
cli_case(output_io minic 2 "" "cannot open output" --emit-bytecode "${examples}/factorial.mc" -o "${CMAKE_CURRENT_BINARY_DIR}/absent-dir/test.mbc")
cli_case(same_output minic 2 "" "must differ" --emit-bytecode "${examples}/factorial.mc" -o "${examples}/factorial.mc")
foreach(example undeclared undeclared_assignment duplicate initializer_scope scope_exit missing_semicolon bad_comment bad_character oversized_literal keyword missing_braces)
  cli_case(source_${example} minic 1 "" "[0-9]+:[0-9]+: error:" --run "${examples}/invalid/${example}.mc")
endforeach()
foreach(example overflow negative_overflow multiply_overflow negate_overflow min_div_overflow min_mod_overflow division_zero remainder_zero)
  foreach(level 0 1)
    cli_case(runtime_${example}_O${level} minic 3 "" "[0-9]+:[0-9]+: runtime error:" --run "${examples}/invalid/${example}.mc" -O${level})
  endforeach()
  add_test(NAME equivalence_${example} COMMAND "${CMAKE_COMMAND}" "-DTOOL=$<TARGET_FILE:minic>"
    "-DSOURCE=${examples}/invalid/${example}.mc" -DEXPECT_STATUS=3 -P "${CMAKE_CURRENT_SOURCE_DIR}/tests/equivalence.cmake")
endforeach()
foreach(example bad_version bad_slot bad_target bad_opcode bad_operand)
  cli_case(vm_${example} minic-vm 2 "" "minic-vm:" "${CMAKE_CURRENT_SOURCE_DIR}/tests/bytecode/${example}.mbc")
endforeach()
foreach(example stack_underflow uninitialized_slot fallthrough nonempty_halt)
  cli_case(vm_${example} minic-vm 3 "" "malformed.mc:1:1: runtime error:" "${CMAKE_CURRENT_SOURCE_DIR}/tests/bytecode/${example}.mbc")
endforeach()
cli_case(vm_limit minic-vm 3 "" "instruction limit exceeded" "${CMAKE_CURRENT_SOURCE_DIR}/tests/bytecode/infinite_loop.mbc" --max-steps 100)
cli_case(vm_trace minic-vm 0 "${examples}/factorial.out" "stack=.*HALT|HALT" "${CMAKE_CURRENT_BINARY_DIR}/factorial.mbc" --trace --max-steps 100000)
set_tests_properties(cli_vm_trace PROPERTIES FIXTURES_REQUIRED bytecode_factorial)
cli_case(vm_no_args minic-vm 2 "" "file is required")
cli_case(vm_unknown minic-vm 2 "" "unknown option" --wat)
cli_case(vm_missing_file minic-vm 2 "" "cannot open" "${CMAKE_CURRENT_BINARY_DIR}/missing.mbc")
cli_case(vm_extra_file minic-vm 2 "" "exactly one" a.mbc b.mbc)
cli_case(vm_missing_limit minic-vm 2 "" "requires one limit" --max-steps)
foreach(limit 0 -1 abc 18446744073709551616 1x)
  cli_case(vm_bad_limit_${limit} minic-vm 2 "" "positive decimal integer" "${CMAKE_CURRENT_BINARY_DIR}/factorial.mbc" --max-steps "${limit}")
endforeach()
add_test(NAME output_safety COMMAND "${CMAKE_COMMAND}" "-DTOOL=$<TARGET_FILE:minic>"
  "-DSOURCE=${examples}/invalid/undeclared.mc" "-DWORK=${CMAKE_CURRENT_BINARY_DIR}"
  -P "${CMAKE_CURRENT_SOURCE_DIR}/tests/output_safety.cmake")
foreach(mode tokens ast ir)
  cli_case(dump_${mode} minic 0 "${CMAKE_CURRENT_SOURCE_DIR}/tests/expected/demo.${mode}" "" --${mode} "${examples}/demo.mc")
endforeach()
cli_case(dump_ir_O1 minic 0 "${CMAKE_CURRENT_SOURCE_DIR}/tests/expected/demo.ir_O1" "" --ir "${examples}/demo.mc" -O1)
