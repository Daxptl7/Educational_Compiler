execute_process(COMMAND "${TOOL}" ${ARGS}
  RESULT_VARIABLE actual_status OUTPUT_VARIABLE actual_output ERROR_VARIABLE actual_error
  TIMEOUT 10)
if(NOT "${actual_status}" STREQUAL "${EXPECT_STATUS}")
  message(FATAL_ERROR "Expected status ${EXPECT_STATUS}, got ${actual_status}\nstdout: ${actual_output}\nstderr: ${actual_error}")
endif()
set(expected_output "")
if(NOT "${EXPECT_FILE}" STREQUAL "")
  file(READ "${EXPECT_FILE}" expected_output)
endif()
if(NOT "${actual_output}" STREQUAL "${expected_output}")
  message(FATAL_ERROR "Output mismatch\nExpected: [${expected_output}]\nActual: [${actual_output}]")
endif()
if("${EXPECT_ERROR}" STREQUAL "")
  if(NOT "${actual_error}" STREQUAL "")
    message(FATAL_ERROR "Unexpected stderr: ${actual_error}")
  endif()
elseif(NOT actual_error MATCHES "${EXPECT_ERROR}")
  message(FATAL_ERROR "Expected diagnostic /${EXPECT_ERROR}/, got: ${actual_error}")
endif()
